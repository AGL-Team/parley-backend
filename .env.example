# Container image versions
PYTHON_VERSION=3.13-slim
POSTGRES_VERSION=17-alpine
AUTHENTIK_VERSION=2026.8.3

# Backend
BACKEND_PORT=8000

# PostgreSQL administrator
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
POSTGRES_ADMIN_DB=postgres
POSTGRES_PORT=5432

# Future Parley backend database
PARLEY_DB_NAME=parley
PARLEY_DB_USER=parley
PARLEY_DB_PASSWORD=change-me-parley-db

# Authentik database
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=change-me-authentik-db

# Generate a long, random value before the first start.
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-secret
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
AUTHENTIK_ERROR_REPORTING_ENABLED=false
